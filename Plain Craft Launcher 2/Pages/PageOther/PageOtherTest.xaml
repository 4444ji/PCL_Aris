<local:MyPageRight x:Class="PageOtherTest"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PCL"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25,25,25,10">
            <local:MyHint Text="为便于维护，开源内容中不包含百宝箱功能。以下为第三方补充的简易工具。" Theme="Yellow" Margin="0,0,0,15" />

            <!-- 网站探活 -->
            <local:MyCard Title="网站探活" Margin="0,0,0,15" CanSwap="True" IsSwapped="False">
                <StackPanel Margin="25,40,23,15">
                    <TextBlock Text="输入网址，检测网站是否存活（10 秒超时）。" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <local:MyTextBox x:Name="TextUrl" HintText="例如 example.com 或 https://example.com" Height="32" />
                    <local:MyButton x:Name="BtnCheck" Text="检测" Height="35" HorizontalAlignment="Left"
                                    Padding="20,0" Margin="0,10,0,0" ColorType="Highlight" />
                </StackPanel>
            </local:MyCard>
                <!-- 自定义下载 -->
            <local:MyCard Title="自定义下载" Margin="0,0,0,15" CanSwap="True" IsSwapped="False">
                <StackPanel Margin="25,40,23,15">
                    <TextBlock Text="输入直链下载文件。默认保存到桌面。" TextWrapping="Wrap" Margin="0,0,0,10" />
                    
                    <local:MyTextBox x:Name="TextDlUrl" HintText="输入文件下载链接 (URL)" Height="32" Margin="0,0,0,8" />
                    <local:MyTextBox x:Name="TextDlName" HintText="保存的文件名（可选，需带后缀，如 test.jar）" Height="32" Margin="0,0,0,8" />
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MyTextBox x:Name="TextDlFolder" HintText="保存目录（默认桌面）" Height="32" />
                        <local:MyButton Grid.Column="1" Text="选择..." Height="32" Margin="8,0,0,0" x:Name="BtnSelectFolder" />
                    </Grid>

                    <local:MyButton x:Name="BtnStartDownload" Text="开始下载" Height="35"
                                    HorizontalAlignment="Left" Padding="20,0" Margin="0,12,0,0" ColorType="Highlight" />
                </StackPanel>
            </local:MyCard>
            <!-- 今日人品 -->
            <local:MyCard Title="今日人品" Margin="0,0,0,15" CanSwap="True" IsSwapped="False">
                <StackPanel Margin="25,40,23,15">
                    <TextBlock Text="每天固定，用识别码做种子。改系统日期可以刷。" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <local:MyButton x:Name="BtnJrrp" Text="测测今日人品" Height="35"
                                    HorizontalAlignment="Left" Padding="20,0" ColorType="Highlight" />
                    
                    <!-- 新增：结果显示框 -->
                    <TextBlock x:Name="LabJrrpResult" Text="" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ColorBrush2}" Margin="0,15,0,0" TextWrapping="Wrap" LineHeight="22" />
                </StackPanel>
            </local:MyCard>

            <!-- 内存优化 -->
            <local:MyCard Title="内存优化" Margin="0,0,0,15" CanSwap="True" IsSwapped="False">
                <StackPanel Margin="25,40,23,15">
                    <TextBlock Text="执行一次温和的 GC 回收，不会强制清空系统工作集。" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <local:MyButton x:Name="BtnMemoryOptimize" Text="执行优化" Height="35"
                                    HorizontalAlignment="Left" Padding="20,0" ColorType="Highlight" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>